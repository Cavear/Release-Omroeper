{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run test:unit)",
      "Bash(npm run test:ui)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(git diff *--output*)",
      "Bash(git -C *)",
      "Bash(git -c *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * -uf*)",
      "Bash(git push *+*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main*)",
      "Bash(git push * refs/heads/main*)",
      "Bash(git push * HEAD*)",
      "Bash(git push --all*)",
      "Bash(git push * --all*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(rm /*)",
      "Bash(rm * /*)",
      "Bash(rm ~*)",
      "Bash(rm * ~*)",
      "Bash(rm ../*)",
      "Bash(rm * ../*)",
      "Bash(rm C:*)",
      "Bash(rm * C:*)",
      "Bash(rm c:*)",
      "Bash(rm * c:*)",
      "Bash(rm D:*)",
      "Bash(rm * D:*)",
      "Bash(rm $HOME*)",
      "Bash(rm * $HOME*)",
      "PowerShell(Remove-Item *)",
      "PowerShell(rm *)",
      "PowerShell(del *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * main)",
      "PowerShell(git push *:main*)"
    ]
  }
}
